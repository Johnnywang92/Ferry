一行 memset，1.11.1 上下文直接对上，不需要 API 适配。
提交号同样来自 Homebrew formula，advisory 的 patches 字段是空的。
影响面：libssh2_publickey_* 我们不调用，与 0009 同因。
---
 src/publickey.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/publickey.c b/src/publickey.c
index e3479719..b83b28df 100644
--- a/src/publickey.c
+++ b/src/publickey.c
@@ -972,6 +972,7 @@ libssh2_publickey_list_fetch(LIBSSH2_PUBLICKEY * pkey, unsigned long *num_keys,
                     goto err_exit;
                 }
                 list = newlist;
+                memset(&list[keys], 0, sizeof(list[keys]));
             }
             if(pkey->version == 1) {
                 unsigned long comment_len;
